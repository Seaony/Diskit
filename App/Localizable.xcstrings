        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone and Mac must be on the same local network. Guest networks, VPNs, or router device isolation may block the connection. If Wireless Debugging was turned off, turn it on again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机和 Mac 需要在同一局域网。访客网络、VPN 或路由器的设备隔离可能阻止连接；无线调试关闭后也需要重新开启。"
          }
        }
      }
    },
