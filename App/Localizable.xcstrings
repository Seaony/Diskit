            "state": "translated",
            "value": "请填写%@"
          }
        }
      }
    },
    "请填写完整的服务器地址，例如 https://nas.local/dav/": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete server address, such as https://nas.local/dav/."
          }
        },
