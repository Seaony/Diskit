    "请使用支持数据传输的线缆，解锁手机并开启 USB 调试。首次连接时，请在手机上允许这台电脑。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a cable that supports data transfer, unlock your phone, and enable USB debugging. When connecting for the first time, allow this computer on your phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用支持数据传输的线缆，解锁手机并开启 USB 调试。首次连接时，请在手机上允许这台电脑。"
          }
        }
      }
    },
    "请允许 Kayoi 访问本地网络": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Kayoi to access your local network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 Kayoi 访问本地网络"
          }
        }
      }
    },
    "请先填写主机地址，并选择访客或填写用户名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the host address first, then choose Guest or enter a username."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先填写主机地址，并选择访客或填写用户名"
          }
        }
      }
    },
    "请先登录账号": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your account first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录账号"
          }
        }
      }
    },
    "请在下方登录%@。Kayoi 只把登录信息保存在本机钥匙串里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to %@ below. Kayoi stores sign-in information only in your local Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在下方登录%@。Kayoi 只把登录信息保存在本机钥匙串里。"
          }
        }
      }
    },
    "请在可信的局域网中使用 NFS，访问权限由服务器上的导出设置决定。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use NFS on a trusted local network. The server’s export settings control access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在可信的局域网中使用 NFS，访问权限由服务器上的导出设置决定。"
          }
        }
      }
    },
    "请在手机上点“允许 USB 调试”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Allow USB debugging” on your phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手机上点“允许 USB 调试”"
          }
