          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "需要打开 USB 调试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on USB debugging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要打开 USB 调试"
          }
        }
      }
    },
    "无法迁移数据": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to Migrate Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法迁移数据"
          }
        }
      }
    },
    "旧数据已保留。本次继续使用旧存储，下次启动重试。\n%@\n详情见“控制台”中的 Diskit 日志。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your old data was kept. This session will use legacy storage and retry migration on the next launch.\n%@\nSee the Diskit logs in Console for details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧数据已保留。本次继续使用旧存储，下次启动重试。\n%@\n详情见“控制台”中的 Diskit 日志。"
          }
        }
      }
    },
    "会先推出正在使用缓存的位置，再删除下载副本。手机和网盘上的原文件、还没上传完的内容都不受影响。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locations using the cache will be ejected before downloaded copies are deleted. Original files on your phone and cloud drives, and anything not yet uploaded, will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先推出正在使用缓存的位置，再删除下载副本。手机和网盘上的原文件、还没上传完的内容都不受影响。"
          }
        }
      }
    },
    "会先推出这个位置，再删除保存的登录信息。原文件不受影响。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This location will be ejected before its saved sign-in information is deleted. Your original files won’t be affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先推出这个位置，再删除保存的登录信息。原文件不受影响。"
          }
        }
      }
    },
    "启用文件系统扩展": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable File System Extension"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用文件系统扩展"
          }
        }
      }
    },
    "在系统设置中启用 Diskit 后即可挂载位置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Diskit in System Settings to mount locations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中启用 Diskit 后即可挂载位置。"
