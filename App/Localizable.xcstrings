          }
        }
      }
    },
    "在 Kayoi 中选择发现的手机，输入手机显示的 6 位配对码。配对码过期后，请重新打开手机上的配对窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the discovered phone in Kayoi and enter the 6-digit code shown on it. If the code expires, reopen the pairing window on your phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Kayoi 中选择发现的手机，输入手机显示的 6 位配对码。配对码过期后，请重新打开手机上的配对窗口。"
          }
        }
      }
    },
    "在 NAS 上启用 WebDAV Server 的 HTTPS 服务，并允许此账户访问目标共享。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable HTTPS in WebDAV Server on your NAS and grant this account access to the target share."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 NAS 上启用 WebDAV Server 的 HTTPS 服务，并允许此账户访问目标共享。"
          }
        }
      }
    },
    "在 NAS 上开启 WebDAV，并使用实际配置的端口与共享路径。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable WebDAV on your NAS and use its configured port and share path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 NAS 上开启 WebDAV，并使用实际配置的端口与共享路径。"
          }
        }
      }
    },
    "在 NAS 或服务器上开启 NFS，并创建导出目录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable NFS on your NAS or server and create an exported directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 NAS 或服务器上开启 NFS，并创建导出目录。"
          }
        }
      }
    },
    "在 Windows 的网络设置中开启文件和打印机共享，并给账户授予目标文件夹的访问权限。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on File and Printer Sharing in Windows network settings and grant the account access to the target folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Windows 的网络设置中开启文件和打印机共享，并给账户授予目标文件夹的访问权限。"
          }
        }
      }
    },
    "在 Windows、Mac 或 NAS 上开启文件共享，并为要连接的文件夹设置访问权限。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable file sharing on Windows, Mac, or your NAS and set access permissions for the folder you want to connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Windows、Mac 或 NAS 上开启文件共享，并为要连接的文件夹设置访问权限。"
          }
        }
      }
    },
    "在%@网页完成登录后，从浏览器开发者工具的网络请求中复制 Cookie 请求头，再粘贴到这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After signing in on the %@ website, copy the Cookie header from a network request in your browser’s developer tools and paste it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@网页完成登录后，从浏览器开发者工具的网络请求中复制 Cookie 请求头，再粘贴到这里。"
          }
        }
      }
    },
    "在个人设置中创建应用密码，并复制服务器提供的 WebDAV 地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an app password in your personal settings and copy the WebDAV address supplied by the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在个人设置中创建应用密码，并复制服务器提供的 WebDAV 地址。"
          }
        }
      }
    },
    "在个人设置的安全页面创建应用密码，并从文件页面复制 WebDAV 地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an app password on the security page in your personal settings, then copy the WebDAV address from the files page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在个人设置的安全页面创建应用密码，并从文件页面复制 WebDAV 地址。"
          }
        }
      }
    },
    "在位置右侧选择“重新登录”，重新完成服务商要求的授权或验证。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose “Sign In Again” on the right of the location, then complete the provider’s authorization or verification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在位置右侧选择“重新登录”，重新完成服务商要求的授权或验证。"
          }
        }
      }
    },
    "在坚果云账号的安全设置中创建应用密码，用户名填写账号邮箱。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an app password in your Nutstore account’s security settings. Use your account email as the username."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在坚果云账号的安全设置中创建应用密码，用户名填写账号邮箱。"
          }
        }
      }
    },
    "在开发者选项中打开无线调试，再选择“使用配对码配对设备”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Wireless Debugging in Developer Options, then choose “Pair device with pairing code”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在开发者选项中打开无线调试，再选择“使用配对码配对设备”。"
          }
        }
      }
    },
    "在手机设置中开启开发者选项和 USB 调试，再用支持数据传输的数据线连接 Mac。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Developer Options and USB debugging in your phone’s settings, then connect it to your Mac with a cable that supports data transfer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机设置中开启开发者选项和 USB 调试，再用支持数据传输的数据线连接 Mac。"
          }
        }
      }
    },
    "在手机设置中开启开发者选项，再打开 USB 调试或无线调试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Developer Options in your phone’s settings, then enable USB debugging or Wireless Debugging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机设置中开启开发者选项，再打开 USB 调试或无线调试。"
          }
        }
      }
    },
    "在服务商自己的授权页完成登录，Kayoi 只保存连接所需的登录信息。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in on the provider’s own authorization page. Kayoi saves only the information needed to connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务商自己的授权页完成登录，Kayoi 只保存连接所需的登录信息。"
          }
        }
      }
    },
    "在服务端允许这台 Mac 的 IP 地址访问，再填写服务器地址和完整导出路径。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow your Mac’s IP address on the server, then enter the server address and full export path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务端允许这台 Mac 的 IP 地址访问，再填写服务器地址和完整导出路径。"
          }
        }
      }
    },
    "在移动云盘网页完成登录后，从浏览器开发者工具的网络请求中复制 Authorization 请求头，保留 Basic 前缀或只粘贴后面的内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After signing in on the Mobile Cloud website, copy the Authorization header from a network request in your browser’s developer tools. Keep the Basic prefix or paste only the value after it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在移动云盘网页完成登录后，从浏览器开发者工具的网络请求中复制 Authorization 请求头，保留 Basic 前缀或只粘贴后面的内容。"
          }
        }
      }
    },
    "在系统设置中允许 Kayoi 开机自动启动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Kayoi to launch at login in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中允许 Kayoi 开机自动启动"
          }
        }
      }
    },
    "在迅雷云盘网页完成登录后，从浏览器开发者工具的网络请求中复制 Authorization 请求头，保留 Token 前缀或只粘贴后面的内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After signing in on the Xunlei Drive website, copy the Authorization header from a network request in your browser’s developer tools. Keep the Token prefix or paste only the value after it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在迅雷云盘网页完成登录后，从浏览器开发者工具的网络请求中复制 Authorization 请求头，保留 Token 前缀或只粘贴后面的内容。"
          }
        }
      }
    },
    "坚果云": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jianguoyun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坚果云"
          }
        }
      }
    },
    "填写服务地址、区域、存储桶名称、访问密钥 ID 和访问密钥。MinIO 使用自己的服务器地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the service endpoint, region, bucket name, access key ID, and secret access key. For MinIO, use your own server address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写服务地址、区域、存储桶名称、访问密钥 ID 和访问密钥。MinIO 使用自己的服务器地址。"
          }
        }
      }
    },
    "填写电脑的 IP 地址或主机名，再填写用户名、密码和共享名。共享名不等于电脑上的完整文件路径。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the computer’s IP address or hostname, then the username, password, and share name. The share name is not the full file path on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写电脑的 IP 地址或主机名，再填写用户名、密码和共享名。共享名不等于电脑上的完整文件路径。"
          }
        }
      }
    },
