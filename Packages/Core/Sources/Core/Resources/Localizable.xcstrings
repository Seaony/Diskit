{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "PikPak 没有完成任务，请稍后重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PikPak did not finish the task. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PikPak 没有完成任务，请稍后重试"
          }
        }
      }
    },
    "PikPak 登录已失效，请重新登录": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PikPak sign-in has expired. Sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PikPak 登录已失效，请重新登录"
