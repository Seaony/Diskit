    "删除未完成：已确认删除 %lld / %lld 个对象，失败对象的状态尚未确认。请刷新后检查剩余内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion did not finish. Confirmed deleted: %#@deleted@ of %#@total@. The failed object’s status is unconfirmed. Refresh to check what remains."
          },
          "substitutions": {
            "deleted": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg"
                    }
                  }
                }
              }
            },
            "total": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg object"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg objects"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除未完成：已确认删除 %#@deleted@ / %#@total@ 个对象，失败对象的状态尚未确认。请刷新后检查剩余内容。"
          },
          "substitutions": {
            "deleted": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg"
                    }
                  }
                }
              }
            },
            "total": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
