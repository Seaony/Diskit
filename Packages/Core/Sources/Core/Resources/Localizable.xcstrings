        }
      }
    },
    "PikPak 返回了无法识别的数据，接口可能已经变化": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PikPak returned unrecognized data. The interface may have changed."
