      }
    },
    "PikPak 账号或密码不正确，请重新输入": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PikPak account or password is incorrect. Enter them again."
